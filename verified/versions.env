# The versions the verified build depends on. This file is the one record.
#
# Rule: these four are upgraded together, in one commit. Each Aeneas commit
# works with exactly one Charon commit (its `charon-pin`) and one Lean and
# mathlib version (its `backends/lean`), and `lean/` and `verified/lean` are
# built as one Lean project. To upgrade: choose an Aeneas commit, copy its
# Charon commit, Lean version and mathlib version here, change the files
# listed in `check-versions.sh` to match, run `extract.sh`, and repair the
# proofs. `check-versions.sh` fails in CI while any of them disagrees.
#
# The Rust nightly that Charon compiles the crate with is fixed by the Charon
# commit (its `rust-toolchain` file), so it is not recorded separately.
AENEAS_COMMIT=5a392f4b80a4d0d05abc240eb2a7fa70622a9a35
CHARON_COMMIT=454586e9b770231e66d2062993e632dfc06463e2
LEAN_VERSION=v4.35.0
MATHLIB_VERSION=v4.35.0
